  <metadata>
    <id>rtk</id>
    <version>0.0.0</version>
    <title>RTK (Rust Token Killer)</title>
    <authors>Patrick Szymkowiak</authors>
    <owners>rtk-ai</owners>
    <projectUrl>https://www.rtk-ai.app</projectUrl>
