T00:05:12Z"}},"url":"https://api.github.com/repos/rtk-ai/rtk/commits/198989966424a7514a7fae7e1a0190a08d5b500a","html_url":"https://github.com/rtk-ai/rtk/commit/198989966424a7514a7fae7e1a0190a08d5b500a","comments_url":"https://api.github.com/repos/rtk-ai/rtk/commits/198989966424a7514a7fae7e1a0190a08d5b500a/comments","author":{"login":"KuSh","id":60970,"node_id":"MDQ6VXNlcjYwOTcw","avatar_url":"https://avatars.githubusercontent.com/u/60970?v=4","gravatar_id":"","url":"https://api.github.com/users/KuSh","html_url":"https://github.com/KuSh","followers_url":"https://api.github.com/users/KuSh/followers","following_url":"https://api.github.com/users/KuSh/following{/other_user}","gists_url":"https://api.github.com/users/KuSh/gists{/gist_id}","starred_url":"https://api.github.com/users/KuSh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KuSh/subscriptions","organizations_url":"https://api.github.com/users/KuSh/orgs","repos_url":"https://api.github.com/users/KuSh/repos","events_url":"https://api.github.com/users/KuSh/events{/privacy}","received_events_url":"https://api.github.com/users/KuSh/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9936b2b9ce560283d7be21fdfad027cb537be69c","url":"https://api.github.com/repos/rtk-ai/rtk/commits/9936b2b9ce560283d7be21fdfad027cb537be69c","html_url":"https://github.com/rtk-ai/rtk/commit/9936b2b9ce560283d7be21fdfad027cb537be69c"},{"sha":"ae5d1aec0c534aea2e8d374c437a8f81e051208c","url":"https://api.github.com/repos/rtk-ai/rtk/commits/ae5d1aec0c534aea2e8d374c437a8f81e051208c","html_url":"https://github.com/rtk-ai/rtk/commit/ae5d1aec0c534aea2e8d374c437a8f81e051208c"}]},{"sha":"ae5d1aec0c534aea2e8d374c437a8f81e051208c","node_id":"C_kwDOQ_KVhNoAKGFlNWQxYWVjMGM1MzRhZWEyZThkMzc0YzQzN2E4ZjgxZTA1MTIwOGM","commit":{"author":{"name":"Fixture Author","email":"author@example.com","date":"2026-08-11T23:33:00Z"},"committer":{"name":"Fixture Committer","email":"committer@example.com","date":"2026-08-11T23:33:00Z"},"message":"fix(stream): address review feedback on read_lines_lossy\n\nKuSh's review on this PR flagged two real issues in read_lines_lossy:\n- Ok(0) | Err(_) => None treated a genuine I/O error the same as clean\n  EOF, silently truncating output on a real read failure -- exactly\n  the \"failing build looks clean\" class of bug this PR exists to fix,\n  just relocated rather than removed.\n- A fresh Vec was allocated every iteration on a hot streaming path\n  instead of reusing std's own buffered split.\n\nReplaced the hand-rolled read_until loop with BufReader::split(b'\\n'),\nper the reviewer's suggested implementation: reuses std instead of\nreimplementing it (except CR-stripping, which split() doesn't do),\nand now surfaces a genuine I/O error to stderr instead of silently\nconflating it with EOF.\n\nAdded a test with a Read impl that yields good lines then a real\nerror, confirming the error path doesn't panic or hang and the\nalready-read lines are still preserved.","tree":{"sha":"c43d3b362a27b62e48dfb9e65e63a5addcdb118b","url":"https://api.github.com/repos/rtk-ai/rtk/git/trees/c43d3b362a27b62e48dfb9e65e63a5addcdb118b"},"url":"https://api.github.com/repos/rtk-ai/rtk/git/commits/ae5d1aec0c534aea2e8d374c437a8f81e051208c","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmxTM2V50A5PA9PNJKXLffl37ki\nX/d/rKO5GLuYxuvJoAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQKvMmQcbLvdn1KUgf/B0zqQLMe1J3/M8YtxvbaKRxWMlzGI7JTcreGFbvUsLStK0e0\n4mRaX71JYM0XceH6Fm4Qw=\n-----END SSH SIGNATURE-----","payload":"tree c43d3b362a27b62e48dfb9e65e63a5addcdb118b\nparent a3ba3c5fb00e802b03bfc83171d4e7ca1271c4d2\nauthor Chris Brown <257249062+albatrossflyon-coder@users.noreply.github.com> 1786491180 -0500\ncommitter Chris Brown <257249062+albatrossflyon-coder@users.noreply.github.com> 1786491180 -0500\n\nfix(stream): address review feedback on read_lines_lossy\n\nKuSh's review on this PR flagged two real issues in read_lines_lossy:\n- Ok(0) | Err(_) => None treated a genuine I/O error the same as clean\n  EOF, silently truncating output on a real read failure -- exactly\n  the \"failing build looks clean\" class of bug this PR exists to fix,\n  just relocated rather than removed.\n- A fresh Vec was allocated every iteration on a hot streaming path\n  instead of reusing std's own buffered split.\n\nReplaced the hand-rolled read_until loop with BufReader::split(b'\\n'),\nper the reviewer's suggested implementation: reuses std instead of\nreimplementing it (except CR-stripping, which split() doesn't do),\nand now surfaces a genuine I/O error to stderr instead of silently\nconflating it with EOF.\n\nAdded a test with a Read impl that yields good lines then a real\nerror, confirming the error path doesn't panic or hang and the\nalready-read lines are still preserved.\n","verified_at":"2026-08-11T23:33:14Z"}},"url":"https://api.github.com/repos/rtk-ai/rtk/commits/ae5d1aec0c534aea2e8d374c437a8f81e051208c","html_url":"https://github.com/rtk-ai/rtk/commit/ae5d1aec0c534aea2e8d374c437a8f81e051208c","comments_url":"https://api.github.com/repos/rtk-ai/rtk/commits/ae5d1aec0c534aea2e8d374c437a8f81e051208c/comments","author":{"login":"albatrossflyon-coder","id":257249062,"node_id":"U_kgDOD1VPJg","avatar_url":"https://avatars.githubusercontent.com/u/257249062?v=4","gravatar_id":"","url":"https://api.github.com/users/albatrossflyon-coder","html_url":"https://github.com/albatrossflyon-coder","followers_url":"https://api.github.com/users/albatrossflyon-coder/followers","following_url":"https://api.github.com/users/albatrossflyon-coder/following{/other_user}","gists_url":"https://api.github.com/users/albatrossflyon-coder/gists{/gist_id}","starred_url":"https://api.github.com/users/albatrossflyon-coder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/albatrossflyon-coder/subscriptions","organizations_url":"https://api.github.com/users/albatrossflyon-coder/orgs","repos_url":"https://api.github.com/users/albatrossflyon-coder/repos","events_url":"https://api.github.com/users/albatrossflyon-coder/events{/privacy}","received_events_url":"https://api.github.com/users/albatrossflyon-coder/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"albatrossflyon-coder","id":257249062,"node_id":"U_kgDOD1VPJg","avatar_url":"https://avatars.githubusercontent.com/u/257249062?v=4","gravatar_id":"","url":"https://api.github.com/users/albatrossflyon-coder","html_url":"https://github.com/albatrossflyon-coder","followers_url":"https://api.github.com/users/albatrossflyon-coder/followers","following_url":"https://api.github.com/users/albatrossflyon-coder/following{/other_user}","gists_url":"https://api.github.com/users/albatrossflyon-coder/gists{/gist_id}","starred_url":"https://api.github.com/users/albatrossflyon-coder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/albatrossflyon-coder/