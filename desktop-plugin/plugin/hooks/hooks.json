{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/summary.sh\" start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*plugin_rtk_rtk-desktop__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/allow.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob|mcp__remote-devices__device_bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/pre.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__remote-devices__device_bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/device_post.sh\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "mcp__.*rtk_task_setup$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/setup_post.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/summary.sh\" stop"
          }
        ]
      }
    ]
  }
}