.fastembed_cache/

# Release archives, produced at the repo root by the packaging steps. Build
# output, never committed.
/rtk-*.tar.gz
/rtk-*.zip

# A SQLite sentinel, never a real file. Committing one makes the repo
# impossible to check out on Windows, where `:` cannot appear in a path.
:memory:

__pycache__/
*.pyc
