# Build
/target
proxy/target/
# proxy/Cargo.lock IS committed: `proxy/` is its own workspace root (not a
# member of the root one, which would break `cargo install --git`), and a
# binary crate's lockfile belongs in the repository so a release is
# reproducible. It also pins libsqlite3-sys, which must match the root's.
.cargo-cross/

# Environment & Secrets
.env
.env.*
*.pem
*.key
*.crt
*.p12
credentials.json
secrets.json
*.secret

# Local Claude Code config (may contain machine-local settings/tokens)
.claude/settings.local.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

.next

# OS
.DS_Store
Thumbs.db

